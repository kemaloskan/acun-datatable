{
  "name": "@acunsoft/datatable-dom",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean --external @acunsoft/datatable-core && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\""
  },
  "dependencies": {
    "@acunsoft/datatable-core": "0.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
