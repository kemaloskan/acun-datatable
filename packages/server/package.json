{
  "name": "@acunsoft/datatable-server",
  "version": "0.4.0",
  "description": "Node back end for Acun DataTable (Next.js, Express, Fastify): reads and checks the table query against a column allowlist, builds parameterized SQL (PostgreSQL, MySQL, MariaDB, SQLite, SQL Server) or Prisma arguments, and answers in the table or DataTables format.",
  "keywords": [
    "datatable",
    "data-table",
    "server-side",
    "nextjs",
    "express",
    "prisma",
    "sql",
    "sql-server",
    "pagination"
  ],
  "homepage": "https://kemaloskan.github.io/acun-datatable/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemaloskan/acun-datatable.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/kemaloskan/acun-datatable/issues"
  },
  "author": "Kemal OSKAN (https://github.com/kemaloskan)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "import": "./dist/import.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "build": "tsup src/index.ts src/import.ts --format esm --dts --clean --no-splitting --external @acunsoft/datatable-core --external @acunsoft/datatable-export"
  },
  "dependencies": {
    "@acunsoft/datatable-core": "0.4.0"
  },
  "devDependencies": {
    "mssql": "12.7.2",
    "mysql2": "3.24.5",
    "pg": "8.23.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5",
    "@acunsoft/datatable-export": "0.4.0",
    "@acunsoft/datatable-import": "0.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@acunsoft/datatable-export": "0.4.0"
  },
  "peerDependenciesMeta": {
    "@acunsoft/datatable-export": {
      "optional": true
    }
  }
}
