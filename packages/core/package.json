{
  "name": "@acunsoft/datatable-core",
  "version": "0.3.0",
  "description": "Headless, framework-independent data table engine: typed columns, sorting, Turkish-aware search and filters, pagination, selection.",
  "keywords": [
    "datatable",
    "data-table",
    "table",
    "headless",
    "sorting",
    "filtering",
    "pagination",
    "typescript"
  ],
  "homepage": "https://kemaloskan.github.io/acun-datatable/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemaloskan/acun-datatable.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/kemaloskan/acun-datatable/issues"
  },
  "author": "Kemal OSKAN (https://github.com/kemaloskan)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "benchmark": "npm run build && node benchmarks/local-sorting.mjs"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
