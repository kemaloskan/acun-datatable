{
  "name": "acun-datatable-workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemaloskan/acun-datatable.git"
  },
  "workspaces": [
    "packages/core",
    "packages/datasource-http",
    "packages/server",
    "packages/renderer-dom",
    "packages/export",
    "packages/datatable",
    "packages/vue",
    "packages/react"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run build && playwright test",
    "e2e:chromium": "npm run build && playwright test --project=chromium",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run check && npm run test && npm run build && changeset publish",
    "size": "node scripts/size.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1"
  }
}
