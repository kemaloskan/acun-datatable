{
  "name": "acun-datatable-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run build && playwright test",
    "e2e:chromium": "npm run build && playwright test --project=chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
